# Copy to .env and adjust. See src/lib/api/client.ts for how the URL is used.
#
# MUST include the scheme. Without it (`127.0.0.1:4000`) the browser treats the
# value as a relative path and requests the Next.js app instead of the API,
# which surfaces as "Request rejected" rather than a connection error.
#
# This is NEXT_PUBLIC_, so the value is inlined at build time — it cannot be
# changed by a running server.
#
# Browser requests only. `credentials: "include"` is a browser contract; Node's
# fetch attaches no cookie, so calling ApiClient from a Server Component or a
# route handler issues an unauthenticated request that fails as 401. To call the
# API server-side, read the cookie with `cookies()` from `next/headers` and
# forward it as an explicit `cookie` header — see the Next auth guide in
# node_modules/next/dist/docs/01-app/02-guides/authentication.md.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
