# Integration test environment — NEVER use in production
# Uses local Docker MongoDB (see docker run command in README)
# Reference: .env.example for full list of required vars

MONGODB_URI=mongodb://127.0.0.1:27018/devconnector_test

# JWT secret for integration tests — must be >= 32 chars
JWT_SECRET=integration-test-jwt-secret-at-least-32-characters-long

# Frontend URL for CORS / OAuth redirects
FRONTEND_URL=http://localhost:3000

# GitHub — dummy token for integration tests
GITHUB_ACCESS_TOKEN=test-token

# Google OAuth — dummy values for integration tests
GOOGLE_CLIENT_ID=test-id
GOOGLE_CLIENT_SECRET=test-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
