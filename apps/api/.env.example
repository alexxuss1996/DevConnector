# Copy to .env and fill in values — see src/config/env.ts
# Required: JWT_SECRET, MONGODB_URI, FRONTEND_URL, GITHUB_ACCESS_TOKEN,
#           GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL

# MongoDB Atlas (or local mongod) — must be reachable from src/plugins/mongoose.ts
MONGODB_URI=mongodb://localhost:27017/devconnector
# Alt Atlas example:
# MONGODB_URI=mongodb://user:pass@cluster0-shard-00-00.xxx.mongodb.net:27017,cluster0-shard-00-01.xxx.mongodb.net:27017,cluster0-shard-00-02.xxx.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin&appName=Cluster0

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-base64-string-at-least-32-chars

# Frontend origin for CORS / OAuth redirects
FRONTEND_URL=http://localhost:3000

# GitHub — personal access token used in src/routes/profile/get-github-repos.ts
# Create at https://github.com/settings/tokens (classic) — no scopes needed for public repos
GITHUB_ACCESS_TOKEN=ghp_example_token_replace_me

# Google OAuth 2.0 — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=78277932522-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example-replace-me
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
