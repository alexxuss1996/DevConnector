{
  "name": "api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --env-file=.env --test \"test/**/*.test.ts\"",
    "start": "npm run build:ts && fastify start -l info -p 4000 dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P -p 4000 dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "argon2": "^0.45.1",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "gravatar-url": "^4.0.2",
    "mongoose": "^9.9.0",
    "typebox": "^1.3.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "typescript": "~5.9.2"
  },
  "imports": {
    "#helpers/*": "./dist/helpers/*.js",
    "#modules/*": "./dist/modules/*.js",
    "#routes/*": "./dist/routes/*.js",
    "#test/*": "./dist/test/*.js",
    "#types/*": "./dist/types/*.js",
    "#plugins/*": "./dist/plugins/*.js",
    "#config/*": "./dist/config/*.js",
    "#hooks/*": "./dist/hooks/*.js"
  }
}
